{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../README.md",
        "../docs/*.md",
        "../packages/*/README.md",
        "../packages/*/package.json",
        "../packages/protocol/PROTOCOL.md"
      ],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": []
    }
  }
}
