{
  "name": "@ts-pf/stream",
  "version": "0.1.0",
  "description": "Opt-in StreamCodec and stream() for root AsyncIterable (JSONL)",
  "keywords": [
    "ts-pf",
    "typescript",
    "rpc",
    "typesafe",
    "typed-rpc",
    "api",
    "contract-first",
    "streaming",
    "jsonl",
    "async-iterable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/stream"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/stream#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@ts-pf/contract": "0.1.0",
    "@ts-pf/http": "0.1.0",
    "@ts-pf/protocol": "0.1.0"
  },
  "devDependencies": {
    "@ts-pf/client": "0.1.0",
    "@ts-pf/client-http": "0.1.0",
    "@ts-pf/server": "0.1.0",
    "@ts-pf/server-http": "0.1.0",
    "zod": "^4.0.0"
  }
}
