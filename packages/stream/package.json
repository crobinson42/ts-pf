{
  "name": "@ts-pf/stream",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@ts-pf/contract": "*",
    "@ts-pf/http": "*",
    "@ts-pf/protocol": "*"
  },
  "devDependencies": {
    "@ts-pf/client": "*",
    "@ts-pf/client-http": "*",
    "@ts-pf/server": "*",
    "@ts-pf/server-http": "*",
    "zod": "^4.0.0"
  }
}
