{
  "name": "@ts-pf/http",
  "version": "0.1.0-beta.1",
  "description": "HTTP wire helpers: JSONCodec, RpcCodec, PROTOCOL_HEADER, path helpers, httpStatus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/protocol": "0.1.0-beta.1"
  }
}
