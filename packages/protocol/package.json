{
  "name": "@ts-pf/protocol",
  "version": "0.1.0-beta.1",
  "description": "Portable JSON RPC envelope, PFError, and PROTOCOL_VERSION",
  "keywords": [
    "ts-pf",
    "typescript",
    "rpc",
    "typesafe",
    "typed-rpc",
    "api",
    "contract-first",
    "json-rpc",
    "protocol",
    "envelope"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
