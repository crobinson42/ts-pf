{
  "name": "@ts-pf/mvc-kit",
  "version": "0.1.0-beta.1",
  "description": "Opt-in bindClient and issuesToFieldErrors for mvc-kit Resources",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/mvc-kit"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/mvc-kit#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
