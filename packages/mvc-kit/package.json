      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/contract": "0.1.0-beta.1"
  },
  "peerDependencies": {
    "mvc-kit": ">=4.9.0"
  },
  "devDependencies": {
    "@ts-pf/client": "0.1.0-beta.1",
    "@ts-pf/protocol": "0.1.0-beta.1",
    "@ts-pf/server": "0.1.0-beta.1",
    "mvc-kit": "^4.9.0",
    "zod": "^4.0.0"
