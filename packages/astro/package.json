{
  "name": "@ts-pf/astro",
  "version": "0.2.4",
  "description": "Opt-in Astro endpoint and in-process page caller for ts-pf",
  "keywords": [
    "ts-pf",
    "typescript",
    "rpc",
    "typesafe",
    "typed-rpc",
    "api",
    "contract-first",
    "astro"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/client": "0.2.3",
    "@ts-pf/client-http": "0.2.3",
    "@ts-pf/contract": "0.2.3",
    "@ts-pf/protocol": "0.2.2",
    "@ts-pf/server": "0.4.3",
    "@ts-pf/server-http": "0.3.4"
  },
  "peerDependencies": {
    "astro": ">=4.9.0"
  },
  "devDependencies": {
    "astro": "^7.4.3",
    "zod": "^4.0.0"
  }
}
