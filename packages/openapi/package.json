{
  "name": "@ts-pf/openapi",
  "version": "0.1.0-beta.2",
  "description": "Opt-in OpenAPI 3.1 document from catalog() (POST JSON RPC)",
  "keywords": [
    "ts-pf",
    "typescript",
    "rpc",
    "typesafe",
    "typed-rpc",
    "api",
    "contract-first",
    "openapi",
    "swagger",
    "json-schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/openapi#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/docs": "0.1.0-beta.2"
  },
  "devDependencies": {
    "@ts-pf/contract": "0.1.0-beta.2",
    "@ts-pf/stream": "0.1.0-beta.2",
    "typebox": "^1.3.24",
    "zod": "^4.0.0"
  }
}
