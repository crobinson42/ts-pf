{
  "name": "@ts-pf/sse",
  "version": "0.2.2",
  "description": "Opt-in SseCodec for SSE output framing of the same envelopes",
  "keywords": [
    "ts-pf",
    "typescript",
    "rpc",
    "typesafe",
    "typed-rpc",
    "api",
    "contract-first",
    "sse",
    "server-sent-events",
    "streaming"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/sse"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/sse#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/http": "0.2.1",
    "@ts-pf/protocol": "0.2.1",
    "@ts-pf/stream": "0.2.2"
  },
  "devDependencies": {
    "@ts-pf/client": "0.2.2",
    "@ts-pf/client-http": "0.2.2",
    "@ts-pf/contract": "0.2.2",
    "@ts-pf/server": "0.4.2",
    "@ts-pf/server-http": "0.3.3",
    "zod": "^4.0.0"
  }
}
