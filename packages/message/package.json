{
  "name": "@ts-pf/message",
  "version": "0.1.0",
  "description": "Opt-in JSON text frames and MessageSession for WS, stdio, and MessagePort",
  "keywords": [
    "ts-pf",
    "typescript",
    "rpc",
    "typesafe",
    "typed-rpc",
    "api",
    "contract-first",
    "websocket",
    "stdio",
    "messageport",
    "ipc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/message"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/message#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./stdio": {
      "types": "./src/stdio.ts",
      "import": "./src/stdio.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./stdio": {
        "types": "./dist/stdio.d.ts",
        "import": "./dist/stdio.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/protocol": "0.1.0"
  }
}
