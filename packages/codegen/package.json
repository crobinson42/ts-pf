{
  "name": "@ts-pf/codegen",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ts-pf-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/docs": "*"
  },
  "devDependencies": {
    "@ts-pf/client": "*",
    "@ts-pf/contract": "*",
    "@ts-pf/stream": "*",
    "@types/node": "^22.15.0",
    "typebox": "^1.3.24",
    "zod": "^4.0.0"
  }
}
