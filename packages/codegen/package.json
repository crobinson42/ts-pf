{
  "name": "@ts-pf/codegen",
  "version": "0.0.0",
  "description": "Opt-in .d.ts codegen from catalog() for split-repo createClient",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/codegen#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ts-pf-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@ts-pf/docs": "*"
  },
  "devDependencies": {
    "@ts-pf/client": "*",
    "@ts-pf/contract": "*",
    "@ts-pf/stream": "*",
    "@types/node": "^22.15.0",
    "typebox": "^1.3.24",
    "zod": "^4.0.0"
  }
}
