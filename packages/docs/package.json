{
  "name": "@ts-pf/docs",
  "version": "0.0.0",
  "description": "Opt-in procedure catalog from a contract (docs, catalog)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/ts-pf.git",
    "directory": "packages/docs"
  },
  "homepage": "https://github.com/crobinson42/ts-pf/tree/main/packages/docs#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/ts-pf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@ts-pf/contract": "*",
    "@ts-pf/http": "*",
    "@ts-pf/protocol": "*"
  },
  "peerDependencies": {
    "typebox": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ts-pf/stream": "*",
    "typebox": "^1.3.24",
    "zod": "^4.0.0"
  }
}
