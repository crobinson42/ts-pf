{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noBannedTypes": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.astro",
      "!**/tests/fixtures",
      "!examples/codegen/client/src/contract.d.ts",
      "!site/src/content/docs/packages",
      "!site/src/content/docs/guides",
      "!site/src/content/docs/getting-started.md",
      "!site/src/content/docs/tutorial.md",
      "!site/src/content/docs/protocol.md"
    ]
  }
}
