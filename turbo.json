{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "biome.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "type-check": {
      "dependsOn": ["build", "^build"]
    },
    "lint": {
      "inputs": ["src/**", "tests/**", "package.json"]
    }
  }
}
