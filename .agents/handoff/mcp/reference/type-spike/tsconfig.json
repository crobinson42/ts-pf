{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "lib": ["ES2022"],
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
